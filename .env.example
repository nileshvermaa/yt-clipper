# Copy to .env and fill in.
ANTHROPIC_API_KEY=sk-ant-...

# --- optional overrides (defaults shown) ---
# ANTHROPIC_MODEL=claude-haiku-5-5
# CLIPS_PER_VIDEO=3
# WHISPER_MODEL=large-v3          # CPU only? use small or medium
# WHISPER_DEVICE=auto
# WHISPER_LANGUAGE=               # en, hi, ... empty = auto-detect
# MIN_CLIP_SEC=25
# MAX_CLIP_SEC=75
# CAPTION_FONT=Montserrat ExtraBold
# CAPTION_WORDS_PER_LINE=3
# CREDIT_TEXT=Credit: {channel}
# PRIVACY=private                 # private | unlisted | public
# DAILY_UPLOAD_LIMIT=6
# CATEGORY_ID=24

# --- keep the PC light (defaults shown) ---
# CPU_THREADS=3                   # max CPU threads per step (PC has 12)
# USE_GPU_ENCODE=1                # NVENC/NVDEC video; set 0 to use CPU libx264

# --- framing & quality ---
# FRAMING=auto                   # auto | face | object | center | blur   (blur = whole frame on blurred bg, nothing cropped)
# MAX_SOURCE_HEIGHT=2160          # render from up to 4K stream (0 = use the 1080p analysis copy)
# OUT_FPS=auto                    # keep source fps up to 60, or set e.g. 30

# GPU_FILTERS=1                   # crop/scale/blur on the GPU (Vulkan + libplacebo); 0 = CPU filters

# --- moment picking (Phase 2) ---
# CHANNEL_LANGUAGE=en             # videos spoken in another language are detected and skipped
# SCENE_SIGNAL=1                  # include on-screen activity in the moment score
# HEATMAP_PEAKS=8                 # max top moments sent to Claude
# PEAK_CONTEXT_SEC=45             # transcript seconds either side of each top moment
# PEAK_MIN_GAP_SEC=75             # top moments must be this far apart
# WINDOW_BUDGET_SEC=420           # max total transcript time sent (token cap)

# Phase 4: review gate and pacing
REVIEW_BEFORE_UPLOAD=1
MIN_UPLOAD_GAP_MIN=180
MAX_UPLOADS_PER_RUN=4

# Quality and load
MIN_CROP_HEIGHT=1440
PREPARE_MAX_VIDEOS=2
